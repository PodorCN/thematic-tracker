{
  "name": "thematic-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Theme-first site for PMs (frontend/backend separation; agents only write data/)",
  "scripts": {
    "dev": "node scripts/dev.js",
    "api": "node backend/server.js",
    "validate": "node backend/validate.js",

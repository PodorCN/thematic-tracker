{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rates_decisions pm-review",
  "description": "Independent PM review verdict bound to a frozen candidate SHA. Machine-checked by scripts/validate_pm_review.mjs.",
  "type": "object",
  "required": [
    "schema_version",
    "reviewer",
    "operator",
    "reviewed_at",
    "snapshot_date",
    "candidate_sha256",
    "verdict",
    "executive_summary",
    "checks",
    "findings",
    "flags_dispositioned"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "reviewer": { "type": "string", "minLength": 3 },
    "operator": { "type": "string", "minLength": 3 },
    "reviewed_at": { "type": "string", "description": "ISO8601 with timezone offset" },
    "snapshot_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "candidate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "verdict": { "type": "string", "enum": ["APPROVED", "REVISE"] },
    "executive_summary": { "type": "string", "minLength": 20 },
    "checks": {
      "type": "object",
      "required": [
        "official_policy",
        "pricing",
        "drivers",
        "market_validation",
        "freshness",
        "decision_usefulness"
      ],
      "additionalProperties": false,
      "properties": {
        "official_policy": { "type": "string", "enum": ["pass", "fail"] },
        "pricing": { "type": "string", "enum": ["pass", "fail"] },
        "drivers": { "type": "string", "enum": ["pass", "fail"] },
        "market_validation": { "type": "string", "enum": ["pass", "fail"] },
        "freshness": { "type": "string", "enum": ["pass", "fail"] },
        "decision_usefulness": { "type": "string", "enum": ["pass", "fail"] }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "field", "issue", "evidence", "disposition"],
        "additionalProperties": false,
        "properties": {
          "severity": { "type": "string", "enum": ["critical", "major", "minor"] },
          "field": { "type": "string", "minLength": 3 },
          "issue": { "type": "string", "minLength": 10 },
          "evidence": { "type": "string", "minLength": 10 },
          "disposition": { "type": "string", "enum": ["fixed", "must_fix", "accepted", "next_cycle"] }
        }
      }
    },
    "flags_dispositioned": {
      "type": "array",
      "description": "One entry per machine structural flag from structural-flags.json. Publish refuses if any flag is uncovered.",
      "items": {
        "type": "object",
        "required": ["code", "field", "disposition"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "minLength": 3 },
          "field": { "type": "string", "minLength": 3 },
          "disposition": { "type": "string", "minLength": 5 }
        }
      }
    }
  }
}
